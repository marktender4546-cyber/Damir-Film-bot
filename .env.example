# Telegram bot token from @BotFather
BOT_TOKEN=123456789:PUT_YOUR_REAL_TOKEN_HERE

# Your numeric Telegram user ID. Multiple admins: 123456789,987654321
ADMIN_IDS=123456789

# Optional. For local development, SQLite is used automatically if this is empty.
# For PostgreSQL on Render, set the Internal Database URL or External Database URL here.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. Render automatically supplies RENDER_EXTERNAL_URL.
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_PATH=generate_a_long_random_path
# WEBHOOK_SECRET=generate_a_long_random_secret
LOG_LEVEL=INFO
